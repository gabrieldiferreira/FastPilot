-- FastPilot Local Cache Database
-- Stores sessions, drivers, laps, stints, raw samples and standings for offline/cache-first access

-- ═══════════════════════════════════════════════════════════════
-- Sessions
-- ═══════════════════════════════════════════════════════════════

CREATE TABLE IF NOT EXISTS cached_session (
    session_key INTEGER PRIMARY KEY,
    session_name TEXT NOT NULL,
    session_type TEXT NOT NULL,
    meeting_key INTEGER NOT NULL,
    circuit_short_name TEXT NOT NULL,
    country_name TEXT NOT NULL,
    country_code TEXT NOT NULL DEFAULT '',
    date_start TEXT NOT NULL,
    date_end TEXT NOT NULL,
    year INTEGER NOT NULL,
    cached_at INTEGER NOT NULL,
    -- Circuit time zone ("08:00:00"): race control writes times in it
    gmt_offset TEXT NOT NULL DEFAULT ''
);

selectAllSessions:
SELECT * FROM cached_session ORDER BY date_start DESC;

selectSessionsByYear:
SELECT * FROM cached_session WHERE year = ? ORDER BY date_start DESC;

selectSessionByKey:
SELECT * FROM cached_session WHERE session_key = ?;

selectSessionsByMeeting:
SELECT * FROM cached_session WHERE meeting_key = ? ORDER BY date_start;

insertSession:
INSERT OR REPLACE INTO cached_session(
    session_key, session_name, session_type, meeting_key,
    circuit_short_name, country_name, country_code,
    date_start, date_end, year, cached_at, gmt_offset
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSessionByKey:
DELETE FROM cached_session WHERE session_key = ?;

-- ═══════════════════════════════════════════════════════════════
-- Drivers
-- ═══════════════════════════════════════════════════════════════

CREATE TABLE IF NOT EXISTS cached_driver (
    driver_number INTEGER NOT NULL,
    session_key INTEGER NOT NULL,
    full_name TEXT NOT NULL,
    name_acronym TEXT NOT NULL,
    team_name TEXT NOT NULL,
    team_colour TEXT NOT NULL,
    headshot_url TEXT,
    broadcast_name TEXT,
    cached_at INTEGER NOT NULL,
    PRIMARY KEY (driver_number, session_key)
);

selectDriversBySession:
SELECT * FROM cached_driver WHERE session_key = ?;

selectDriverByNumber:
SELECT * FROM cached_driver WHERE driver_number = ? AND session_key = ?;

insertDriver:
INSERT OR REPLACE INTO cached_driver(
    driver_number, session_key, full_name, name_acronym,
    team_name, team_colour, headshot_url, broadcast_name, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- ═══════════════════════════════════════════════════════════════
-- Laps
-- ═══════════════════════════════════════════════════════════════

CREATE TABLE IF NOT EXISTS cached_lap (
    driver_number INTEGER NOT NULL,
    session_key INTEGER NOT NULL,
    lap_number INTEGER NOT NULL,
    lap_duration REAL,
    sector_1 REAL,
    sector_2 REAL,
    sector_3 REAL,
    i1_speed INTEGER,
    i2_speed INTEGER,
    st_speed INTEGER,
    is_pit_out_lap INTEGER NOT NULL DEFAULT 0,
    date_start TEXT,
    cached_at INTEGER NOT NULL,
    PRIMARY KEY (driver_number, session_key, lap_number)
);

selectLapsByDriverAndSession:
SELECT * FROM cached_lap
WHERE driver_number = ? AND session_key = ?
ORDER BY lap_number;

selectLapByNumber:
SELECT * FROM cached_lap
WHERE driver_number = ? AND session_key = ? AND lap_number = ?;

insertLap:
INSERT OR REPLACE INTO cached_lap(
    driver_number, session_key, lap_number, lap_duration,
    sector_1, sector_2, sector_3, i1_speed, i2_speed, st_speed,
    is_pit_out_lap, date_start, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- ═══════════════════════════════════════════════════════════════
-- Stints
-- ═══════════════════════════════════════════════════════════════

CREATE TABLE IF NOT EXISTS cached_stint (
    driver_number INTEGER NOT NULL,
    session_key INTEGER NOT NULL,
    stint_number INTEGER NOT NULL,
    compound TEXT NOT NULL,
    lap_start INTEGER NOT NULL,
    lap_end INTEGER NOT NULL,
    tyre_age_at_start INTEGER NOT NULL DEFAULT 0,
    cached_at INTEGER NOT NULL,
    PRIMARY KEY (driver_number, session_key, stint_number)
);

selectStintsByDriverAndSession:
SELECT * FROM cached_stint
WHERE driver_number = ? AND session_key = ?
ORDER BY stint_number;

selectStintsBySession:
SELECT * FROM cached_stint
WHERE session_key = ?
ORDER BY driver_number, stint_number;

insertStint:
INSERT OR REPLACE INTO cached_stint(
    driver_number, session_key, stint_number, compound,
    lap_start, lap_end, tyre_age_at_start, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- ═══════════════════════════════════════════════════════════════
-- Raw samples: telemetry (car_data) and track position (location) of one
-- driver in one time window (a lap), stored as the API's JSON. Only data of
-- finished sessions is stored, and it is never downloaded again.
-- ═══════════════════════════════════════════════════════════════

CREATE TABLE IF NOT EXISTS cached_samples (
    endpoint TEXT NOT NULL,
    session_key INTEGER NOT NULL,
    driver_number INTEGER NOT NULL,
    date_gte TEXT NOT NULL,
    date_lte TEXT NOT NULL,
    json TEXT NOT NULL,
    cached_at INTEGER NOT NULL,
    PRIMARY KEY (endpoint, session_key, driver_number, date_gte, date_lte)
);

selectSamples:
SELECT json FROM cached_samples
WHERE endpoint = ? AND session_key = ? AND driver_number = ? AND date_gte = ? AND date_lte = ?;

insertSamples:
INSERT OR REPLACE INTO cached_samples(
    endpoint, session_key, driver_number, date_gte, date_lte, json, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

-- ═══════════════════════════════════════════════════════════════
-- Championship Standings (Jolpica)
-- ═══════════════════════════════════════════════════════════════

CREATE TABLE IF NOT EXISTS cached_driver_standing (
    season INTEGER NOT NULL,
    position INTEGER NOT NULL,
    round INTEGER NOT NULL,
    driver_id TEXT NOT NULL,
    code TEXT NOT NULL,
    full_name TEXT NOT NULL,
    constructor_id TEXT NOT NULL,
    constructor_name TEXT NOT NULL,
    points REAL NOT NULL,
    wins INTEGER NOT NULL,
    cached_at INTEGER NOT NULL,
    PRIMARY KEY (season, position)
);

CREATE TABLE IF NOT EXISTS cached_constructor_standing (
    season INTEGER NOT NULL,
    position INTEGER NOT NULL,
    round INTEGER NOT NULL,
    constructor_id TEXT NOT NULL,
    name TEXT NOT NULL,
    points REAL NOT NULL,
    wins INTEGER NOT NULL,
    cached_at INTEGER NOT NULL,
    PRIMARY KEY (season, position)
);

selectDriverStandingsBySeason:
SELECT * FROM cached_driver_standing WHERE season = ? ORDER BY position;

insertDriverStanding:
INSERT OR REPLACE INTO cached_driver_standing(
    season, position, round, driver_id, code, full_name,
    constructor_id, constructor_name, points, wins, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteDriverStandingsBySeason:
DELETE FROM cached_driver_standing WHERE season = ?;

selectConstructorStandingsBySeason:
SELECT * FROM cached_constructor_standing WHERE season = ? ORDER BY position;

insertConstructorStanding:
INSERT OR REPLACE INTO cached_constructor_standing(
    season, position, round, constructor_id, name, points, wins, cached_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteConstructorStandingsBySeason:
DELETE FROM cached_constructor_standing WHERE season = ?;

-- ═══════════════════════════════════════════════════════════════
-- Cache Management
-- ═══════════════════════════════════════════════════════════════

clearSessionCache:
DELETE FROM cached_session WHERE cached_at < ?;

clearDriverCache:
DELETE FROM cached_driver WHERE cached_at < ?;

clearLapCache:
DELETE FROM cached_lap WHERE cached_at < ?;

clearStintCache:
DELETE FROM cached_stint WHERE cached_at < ?;

clearSamplesCache:
DELETE FROM cached_samples WHERE cached_at < ?;

clearAll {
    DELETE FROM cached_session;
    DELETE FROM cached_driver;
    DELETE FROM cached_lap;
    DELETE FROM cached_stint;
    DELETE FROM cached_samples;
    DELETE FROM cached_driver_standing;
    DELETE FROM cached_constructor_standing;
}
