# FastPilot Web (Kotlin/Wasm) — variáveis para importar na Vercel
# (Project Settings > Environment Variables > Import .env)
#
# O app em si não lê nenhuma variável em tempo de execução: é um site estático e as
# APIs OpenF1 e Jolpica são públicas (URLs no código). As variáveis abaixo configuram só
# o BUILD, feito por scripts/vercel_build.sh (ver vercel.json): a imagem de build da
# Vercel não tem Java, então o JDK 17 é baixado durante o build.
#
# Dados AO VIVO: o proxy api/openf1.mjs precisa da conta Sponsor da OpenF1 em
# OPENF1_USERNAME e OPENF1_PASSWORD. São SEGREDOS: cadastrar direto no painel da Vercel
# (tipo "Sensitive"), nunca neste arquivo, que vai para o repositório.

# JDK 17 (Eclipse Temurin) para Linux x64, usado pelo Gradle
JDK_URL=https://api.adoptium.net/v3/binary/latest/17/ga/linux/x64/jdk/hotspot/normal/eclipse

# Tarefa Gradle que gera o site em composeApp/build/dist/wasmJs/productionExecutable
GRADLE_TASK=:composeApp:wasmJsBrowserDistribution

# Memória da JVM do Gradle (a máquina de build padrão da Vercel tem 8 GB)
GRADLE_JVMARGS=-Xmx3g -XX:MaxMetaspaceSize=1g -Dfile.encoding=UTF-8
